# Discord Webhook Notification URL
# Copy this file to .env and replace with your actual values:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Remote Bridge Bot
DISCORD_BOT_TOKEN=your_bot_token_here
# Comma-separated Discord User IDs allowed to execute commands (leave empty to allow everyone in channel)
ALLOWED_USER_IDS=
# Comma-separated Discord Channel IDs allowed (leave empty to allow any channel bot is in)
ALLOWED_CHANNEL_IDS=
# Default Antigravity model: gemini-3.8-flash-low, gemini-3.8-flash-high, claude-sonnet-4-6, claude-opus-4-6-thinking
DEFAULT_MODEL=gemini-3.8-flash-low

# ---------------------------------------------------------------------------
# API Security & Server Settings
# ---------------------------------------------------------------------------
# Optional API Key / Bearer token for authenticating REST API requests.
# This .env file is loaded into the process environment once at start-up
# (app.py calls dotenv.load_dotenv()), so an API_KEY written here becomes the
# credential that every request is checked against.  An API_KEY that is
# already present in the process environment takes precedence over the value
# written here.
# LEAVE IT EMPTY TO DISABLE AUTHENTICATION COMPLETELY - an empty value means
# "no authentication", so every endpoint is reachable without a credential.
# When it is set, a request must carry 'Authorization: Bearer <token>' or
# 'X-API-Key: <token>'; both are compared as UTF-8 bytes with
# hmac.compare_digest (constant time, so a wrong key cannot be guessed by
# timing).  Anything else - a missing key, a wrong key, or a key that is not
# the configured one, including a non-ASCII key - gets HTTP 401.
# Protected scope: every API endpoint EXCEPT the public ones below - that
# covers /api/v1/*, /api/ga/research/* and any route added later.
# Public (never require a token): '/', '/healthz*', '/static/*',
# '/api/v1/meta/*' and the read-only '/api/v1/system/gpu' diagnostic.
# Every mutating endpoint (POST/PUT/DELETE) stays protected, including
# '/api/v1/system/force-gpu-render'.
# Note: the browser UI sends no token, so setting a key locks the web UI out
# of the API until the UI is given a way to supply the credential.
API_KEY=
# Flask session / application secret key
SECRET_KEY=change_this_to_a_secure_random_string
# Comma-separated list of additional allowed CORS Origins (e.g. http://localhost:3000,https://my-app.domain)
ALLOWED_ORIGINS=
# Server execution environment: development | production | test
ENV=development
# Allow system configuration changes via API (e.g. GPU preferences) in development mode: 0 or 1
PAPER_ALLOW_SYSTEM_CONFIG=0

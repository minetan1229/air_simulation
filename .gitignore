__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

node_modules/
package-lock.json

# Kilo Code local MCP runtime artefacts
.kilo/mcp/memory.jsonl
.kilo/mcp/playwright/

# Imported 3D assets and cached models
models/
*.glb
*.gltf
*.stl
*.obj
*.fbx

# Simulation artefacts
runs/
jobs/
logs/
*.log
*.csv
!tests/**/*.csv
smoke_*.json

# Generated verification artefacts (regenerable with tools/verify_physics_repair.py
# and tools/capture_ui.py; the JSON dumps are tens of megabytes)
artifacts/

# Scratch diagnostics kept in the working tree are not part of the product.
scratch_*
tmp_*.py

.pytest_cache/
.coverage
htmlcov/
.vscode/
.idea/

# Tool caches and CI summaries (listed explicitly instead of relying on the
# self-ignore the tools write into their own cache directory)
.mypy_cache/
.ruff_cache/
pytest_failure_summary.txt

# Prevent accidental shadowing of standard modules
antigravity.py

# Paper collection pipeline cache (regenerable with search/tools/collect_papers.py)
search/.cache/
